{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "RequestsDb": "Data Source=requests.db"
  },
  "Cors": {
    "AllowedOrigins": [ "http://localhost:4200" ]
  },
  "Jwt": {
    "Key": "dev-only-signing-key-for-this-seeded-demo-database-not-for-production-use",
    "Issuer": "Requests.Api",
    "Audience": "Requests.Client",
    "ExpiryMinutes": 60
  }
}
